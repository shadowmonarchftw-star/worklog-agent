{
  "name": "ai-worklog-agent",
  "version": "0.1.9",
  "description": "Local desktop agent for GitHub-based daily worklogs",
  "author": "AI Worklog Agent",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "desktop": "electron .",
    "build": "next build && node scripts/prepare-standalone.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "start": "next start",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "lucide-react": "^1.28.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aiworklogagent.desktop",
    "productName": "AI Worklog Agent",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "server.js",
          "package.json",
          ".next/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
