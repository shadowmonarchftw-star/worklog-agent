{
  "name": "ai-worklog-agent",
  "version": "0.4.0",
  "description": "Local desktop agent for GitHub-based daily worklogs",
  "author": "AI Worklog Agent",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "desktop": "electron .",
    "build": "next build && node scripts/prepare-standalone.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "start": "next start",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aiworklogagent.desktop",
    "productName": "AI Worklog Agent",
    "artifactName": "AI-Worklog-Agent-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "shadowmonarchftw-star",
        "repo": "worklog-agent"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/argparse/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "server.js",
          "package.json",
          ".next/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "artifactName": "AI-Worklog-Agent-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
